# Hosted identity provider. Replace all three values; the example domain is
# intentionally non-routable.
CACHEECONOMICS_OIDC_ISSUER=https://identity.example.invalid/
CACHEECONOMICS_OIDC_AUDIENCE=cacheeconomics-api
CACHEECONOMICS_OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json

# Hosted dashboard OIDC Authorization Code + PKCE settings. The development
# Compose stack can start without these and offers temporary in-memory token
# entry; production rejects that development option.
# CACHEECONOMICS_DASHBOARD_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/authorize
# CACHEECONOMICS_DASHBOARD_OIDC_TOKEN_ENDPOINT=https://identity.example.com/token
# CACHEECONOMICS_DASHBOARD_OIDC_CLIENT_ID=cacheeconomics-dashboard
# CACHEECONOMICS_DASHBOARD_REDIRECT_URI=https://cacheeconomics.example.com/
# DASHBOARD_CONNECT_SRC='self' https://identity.example.com
# DASHBOARD_API_ORIGIN=https://cacheeconomics-api.example.com

# Required when the API runs in production with its Prometheus endpoint on.
# CACHEECONOMICS_METRICS_BEARER_TOKEN=replace-through-a-secrets-manager
