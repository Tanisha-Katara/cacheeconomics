{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cacheeconomics:schema:ingest-batch:v1",
  "title": "cacheeconomics ingest batch v1",
  "description": "A bounded-at-runtime batch of prompt-free ingest events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "ingest-event-v1.schema.json"}
    }
  }
}
