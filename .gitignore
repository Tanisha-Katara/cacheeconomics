# Third-party sources fetched as evidence for Tier A analysis.
# NOT our code — do not vendor. Provenance is recorded in tier-a/SOURCES.md
# (URL + fetch date + sha256), which is reproducible without copying
# other projects' MIT/Apache-licensed source into this repo.
tier-a/openhands/
tier-a/swe-agent/
tier-a/browser-use/

# Raw experiment output stays untracked: on a real workload these rows could
# carry account-specific volume. Must match the filenames ttl_experiment.py
# actually writes (ttl_run_<id>.jsonl).
tier-b/ttl_run_*.jsonl
tier-b/foundry_run_*.jsonl

# ...but the auditable subset IS tracked. Published dollar claims are only
# checkable if the per-call rows behind them travel with them.
!tier-b/evidence/
!tier-b/evidence/*.json

# Never commit credentials
.env
*.key

# Real-trace analysis output. Transcript-derived data never enters the repo,
# even in aggregate — the adapter reads only usage fields, but the safe default
# is that nothing derived from a session transcript is tracked.
harness/out/
*claude-code-trace*

# Build artifacts from `pip install .` / `python -m build`. The package source
# is harness/cacheeconomics; these are generated copies of it.
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# Token-count resume files. Keys are digests now, but the file still records
# which prefixes a client's traffic contains and how large each one is, and it
# is written next to whatever `--out` the operator chose.
*.cache.json

# In-progress token-count output. Renamed into place only on a clean finish, so
# anything left under this name is an aborted run -- and it holds the enriched
# bodies export, prompts included.
*.partial-write

# The other suffix count_tokens derives from --out. Written when some rows
# could not be counted, and it holds the enriched export with request bodies
# intact -- the operator chose the --out path, not this suffix, so ignoring it
# is our job. `*.partial-write` was added and this one, one suffix over, was
# not.
*.partial

# Agent worktrees. Live git repos; never part of this one.
.claude/worktrees/

# The counted export itself. `run_diagnostic.py:_counted_path` and
# `sweep_report.py:counted` derive this from the *input* path (run.jsonl ->
# run-counted.jsonl), which is the other end of the toolchain from `--out` --
# and the three rules above, added one at a time as each `--out` suffix was
# noticed, all missed it for that reason. It is the enriched export with the
# client's request bodies intact, written beside a capture the operator very
# plausibly put inside a checkout.
*-counted.*
